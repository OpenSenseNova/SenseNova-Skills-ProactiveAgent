+export async function submitAcpPrompt(sessionId: string, userQuestion: string): Promise<AcpPromptCompleted> {
+  const raw = await requestJson(
+    '/v1/connectors/acp/prompt',
+    {
+      body: JSON.stringify({ session_id: sessionId, user_question: userQuestion }),
+      headers: { 'Content-Type': 'application/json' },
+      method: 'POST'
+    },
+    180000
+  )
+  const result = asAcpPromptCompleted(raw)
+
+  if (!result || result.requested_session_id !== sessionId) {
+    throw new Error('Proactive Memory returned an invalid ACP prompt result')
+  }
+
+  return result
+}
