+const asAcpPromptCompleted = (value: unknown): AcpPromptCompleted | null => {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return null
+  }
+
+  const raw = value as Record<string, unknown>
+  const required = ['completed_at', 'final_answer', 'platform', 'requested_session_id', 'session_id', 'turn_id']
+
+  if (raw.accepted !== true || typeof raw.session_rebound !== 'boolean' || required.some(key => !asText(raw[key]))) {
+    return null
+  }
+
+  return {
+    accepted: true,
+    completed_at: asText(raw.completed_at),
+    final_answer: asText(raw.final_answer),
+    platform: asText(raw.platform),
+    requested_session_id: asText(raw.requested_session_id),
+    session_id: asText(raw.session_id),
+    session_rebound: raw.session_rebound,
